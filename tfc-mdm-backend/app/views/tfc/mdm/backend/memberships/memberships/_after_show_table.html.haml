%h3= Tfc::Mdm::Memberships::Event.model_name.human(count: :other)

= collection_table(collection: resource.events.order(happened_at: :desc)) do |t|
  = t.id
  = t.association :event_type, label_method: :human, link_to: ->(r) { tfc_mdm_backend.url_for(r.event_type) }
  = t.timestamp :happened_at
  = t.timestamp :effective_at
  = t.timestamps
  = t.column :actions do |resource|
    - capture_haml do
      .btn-group
        = link_to([tfc_mdm_backend, resource], class: 'btn btn-primary btn-xs') do
          %i.fa.fa-eye
          = t('.show')
        = link_to([tfc_mdm_backend, :edit, resource], class: 'btn btn-secondary btn-xs') do
          %i.fa.fa-pen
          = t('.edit')
        = link_to([tfc_mdm_backend, resource], class: 'btn btn-danger btn-xs', method: :delete, 'data-confirm': I18n.t('administrador.controller.confirmations.destroy')) do
          %i.fa.fa-fire
          = t('.destroy')
